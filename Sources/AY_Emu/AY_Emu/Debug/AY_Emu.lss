                                 	;lds		RNGL, AY0_RNGL
                                 	;lds		TabE, AY0_TabE
                                 	;lds		TabP, AY0_TabP
                                 	;lds		EVal, AY0_EVal
0001b9 9508                      	ret
                                 
                                 SAVE_AY1_STATE:
                                 	;sts		AY1_CntN, CntN
